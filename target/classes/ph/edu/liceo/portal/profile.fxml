<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ph.edu.liceo.portal.controller.ProfileController">
    <top>
        <VBox alignment="CENTER" spacing="10.0" styleClass="header-box" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" top="20.0" />
            </padding>
            <Label fx:id="initialsLabel" styleClass="avatar-label" />
            <Label fx:id="nameLabel" styleClass="profile-name" />
        </VBox>
    </top>
    <center>
        <GridPane alignment="CENTER" hgap="10.0" vgap="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label text="Student No:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="studentNoLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Course &amp; Year:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="courseLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="emailLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        </GridPane>
    </center>
    <bottom>
        <VBox alignment="CENTER" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" />
            </padding>
            <Button onAction="#handleLogout" text="LOG OUT" />
        </VBox>
    </bottom>
</BorderPane>